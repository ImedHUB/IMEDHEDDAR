/* ============ STAGE 4: ordering ============ */
let orderNumbers = [];
function buildOrderExercise(){
  const set = new Set();
  while(set.size<5) set.add(randInt(10,999999));
  orderNumbers = Array.from(set);
  const shuffled = [...orderNumbers];
  for(let j=shuffled.length-1;j>0;j--){
    const k=Math.floor(Math.random()*(j+1));
    [shuffled[j],shuffled[k]]=[shuffled[k],shuffled[j]];
  }
  const list = document.getElementById('orderList');
  list.innerHTML = '';
  shuffled.forEach(n=>{
    const li = document.createElement('li');
    li.textContent = toDigits(n);
    li.dataset.value = n;
    li.draggable = true;
    list.appendChild(li);
  });
  attachDragEvents();
  const fb = document.getElementById('orderFeedback');
  fb.className='feedback'; fb.textContent='';
}
function attachDragEvents(){
  const list = document.getElementById('orderList');
  let dragEl = null;
  list.querySelectorAll('li').forEach(li=>{
    li.addEventListener('dragstart', ()=>{ dragEl = li; li.classList.add('dragging'); });
    li.addEventListener('dragend', ()=>{ li.classList.remove('dragging'); });
    li.addEventListener('dragover', (e)=>{
      e.preventDefault();
      li.classList.add('drag-over');
    });
    li.addEventListener('dragleave', ()=> li.classList.remove('drag-over'));
    li.addEventListener('drop', (e)=>{
      e.preventDefault();
      li.classList.remove('drag-over');
      if(dragEl && dragEl!==li){
        const items = Array.from(list.children);
        const dragIdx = items.indexOf(dragEl);
        const dropIdx = items.indexOf(li);
        if(dragIdx < dropIdx) li.after(dragEl);
        else li.before(dragEl);
      }
    });
  });
}
function checkOrder(){
  const items = Array.from(document.getElementById('orderList').children).map(li=>parseInt(li.dataset.value));
  const sorted = [...items].sort((a,b)=>a-b);
  const fb = document.getElementById('orderFeedback');
  fb.classList.add('show');
  const isCorrect = items.every((v,i)=>v===sorted[i]);
  if(isCorrect){
    fb.className='feedback show ok';
    fb.textContent = 'ترتيب صحيح تمامًا! من الأصغر إلى الأكبر. ✅';
  } else {
    fb.className='feedback show bad';
    fb.textContent = 'الترتيب غير صحيح بعد، أعد السحب والإفلات وحاول مجددًا.';
  }
}
