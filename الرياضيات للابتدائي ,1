<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تعلم الرياضيات مع الأستاذ هدار عماد</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=Rakkas&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1B3B6F;
    --navy-dark:#122a52;
    --cream:#FFF8ED;
    --paper:#FFFDF8;
    --orange:#F2994A;
    --orange-dark:#d97e2f;
    --mint:#2FA88A;
    --mint-dark:#238a70;
    --coral:#E8574A;
    --ink:#242021;
    --line:#e7ddc9;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'Tajawal',sans-serif;
    min-height:100vh;
  }

  /* ===== Header ===== */
  header{
    background:linear-gradient(160deg,var(--navy) 0%, var(--navy-dark) 100%);
    color:#fff;
    padding:34px 20px 60px;
    text-align:center;
    position:relative;
    overflow:hidden;
  }
  header::before{
    content:"999,999";
    position:absolute;
    font-family:'Rakkas',serif;
    font-size:9rem;
    opacity:.07;
    top:-20px;
    left:-10px;
    transform:rotate(-8deg);
    white-space:nowrap;
  }
  header h1{
    font-family:'Rakkas',serif;
    font-size:2.3rem;
    margin:0 0 8px;
    position:relative;
    z-index:1;
  }
  header p{
    margin:0;
    font-size:1.05rem;
    opacity:.85;
    position:relative;
    z-index:1;
  }
  .badge-row{
    display:flex;
    justify-content:center;
    gap:10px;
    margin-top:18px;
    flex-wrap:wrap;
    position:relative;
    z-index:1;
  }
  .badge-row span{
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.25);
    padding:6px 14px;
    border-radius:100px;
    font-size:.85rem;
  }

  /* ===== Nav (stages) ===== */
  nav{
    max-width:980px;
    margin:-30px auto 0;
    padding:0 16px;
    position:relative;
    z-index:2;
  }
  .stage-scroller{
    display:flex;
    gap:8px;
    overflow-x:auto;
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:16px;
    padding:10px;
    box-shadow:0 12px 30px -18px rgba(27,59,111,.5);
    scrollbar-width:thin;
  }
  .stage-btn{
    flex:0 0 auto;
    background:transparent;
    border:none;
    padding:10px 16px;
    border-radius:11px;
    font-family:'Tajawal',sans-serif;
    font-weight:700;
    font-size:.92rem;
    color:var(--navy);
    cursor:pointer;
    white-space:nowrap;
    transition:background .18s, color .18s;
  }
  .stage-btn:hover{background:#f1ecdd;}
  .stage-btn.active{
    background:var(--navy);
    color:#fff;
  }

  /* ===== Main ===== */
  main{
    max-width:980px;
    margin:26px auto 60px;
    padding:0 16px;
  }
  .stage{
    display:none;
    animation:fadeIn .35s ease;
  }
  .stage.active{display:block;}
  @keyframes fadeIn{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

  .card{
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:18px;
    padding:26px;
    margin-bottom:20px;
  }
  .stage-title{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:6px;
  }
  .stage-title .icon{
    width:46px;height:46px;
    border-radius:13px;
    background:var(--orange);
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-size:1.4rem;
    flex-shrink:0;
  }
  .stage-title h2{
    font-size:1.4rem;
    margin:0;
    color:var(--navy);
  }
  .stage-sub{
    color:#6b6258;
    margin:0 0 22px;
    font-size:.98rem;
    line-height:1.7;
  }

  /* ===== Place value table ===== */
  .pv-wrap{overflow-x:auto; margin-bottom:6px;}
  table.pv{
    width:100%;
    border-collapse:collapse;
    min-width:640px;
    text-align:center;
  }
  table.pv th{
    font-size:.82rem;
    font-weight:700;
    padding:8px 4px 4px;
    color:#6b6258;
  }
  table.pv .class-head{
    font-size:.95rem;
    font-weight:900;
    color:#fff;
    padding:10px 4px;
  }
  .class-head.thousands{background:var(--mint);}
  .class-head.units{background:var(--orange);}
  table.pv td.cell{
    border:2px solid var(--line);
    font-size:1.6rem;
    font-weight:900;
    padding:14px 6px;
    color:var(--navy);
    background:#fffef9;
    border-radius:8px;
  }
  table.pv td.cell input{
    width:100%;
    border:none;
    background:transparent;
    text-align:center;
    font-size:1.6rem;
    font-weight:900;
    color:var(--navy);
    font-family:inherit;
  }
  table.pv td.cell input:focus{outline:2px solid var(--orange);}

  .big-number-display{
    text-align:center;
    font-size:2.6rem;
    font-weight:900;
    color:var(--navy);
    letter-spacing:2px;
    margin:14px 0 20px;
    direction:ltr;
    font-variant-numeric:tabular-nums;
  }

  /* ===== controls ===== */
  .controls{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:18px;
  }
  input[type=text], input[type=number]{
    font-family:inherit;
    font-size:1rem;
    padding:10px 14px;
    border:2px solid var(--line);
    border-radius:10px;
    background:#fffef9;
  }
  input:focus{outline:none; border-color:var(--orange);}
  button.action{
    font-family:'Tajawal',sans-serif;
    font-weight:700;
    font-size:.95rem;
    background:var(--navy);
    color:#fff;
    border:none;
    padding:11px 20px;
    border-radius:10px;
    cursor:pointer;
    transition:transform .12s, background .15s;
  }
  button.action:hover{background:var(--navy-dark);}
  button.action:active{transform:scale(.97);}
  button.action.orange{background:var(--orange);}
  button.action.orange:hover{background:var(--orange-dark);}
  button.action.mint{background:var(--mint);}
  button.action.mint:hover{background:var(--mint-dark);}
  button.ghost{
    background:transparent;
    border:2px solid var(--line);
    color:var(--navy);
    font-family:inherit;
    font-weight:700;
    padding:9px 16px;
    border-radius:10px;
    cursor:pointer;
  }
  button.ghost:hover{border-color:var(--navy);}

  .feedback{
    margin-top:12px;
    padding:12px 16px;
    border-radius:12px;
    font-weight:700;
    display:none;
  }
  .feedback.show{display:block; animation:fadeIn .25s ease;}
  .feedback.ok{background:#e3f6ef; color:var(--mint-dark); border:1px solid #b9e6d6;}
  .feedback.bad{background:#fdeceb; color:#b5392f; border:1px solid #f4c3bd;}

  /* ===== exercise item ===== */
  .exercise{
    border-top:1px dashed var(--line);
    padding:18px 0;
  }
  .exercise:first-of-type{border-top:none; padding-top:0;}
  .ex-q{
    font-weight:700;
    margin-bottom:10px;
    font-size:1.02rem;
    color:var(--navy);
  }
  .options{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }
  .opt-btn{
    font-family:inherit;
    font-size:.95rem;
    font-weight:700;
    background:#fffef9;
    border:2px solid var(--line);
    padding:9px 16px;
    border-radius:10px;
    cursor:pointer;
    color:var(--ink);
  }
  .opt-btn:hover{border-color:var(--orange);}
  .opt-btn.correct{background:#e3f6ef; border-color:var(--mint); color:var(--mint-dark);}
  .opt-btn.wrong{background:#fdeceb; border-color:var(--coral); color:#b5392f;}
  .opt-btn[disabled]{cursor:default;}

  /* ===== ordering drag list ===== */
  .order-list{
    list-style:none;
    padding:0;
    margin:0;
    display:flex;
    flex-direction:column;
    gap:8px;
  }
  .order-list li{
    background:#fffef9;
    border:2px solid var(--line);
    border-radius:10px;
    padding:12px 16px;
    font-weight:900;
    font-size:1.1rem;
    color:var(--navy);
    cursor:grab;
    direction:ltr;
    text-align:center;
    user-select:none;
    transition:border-color .15s, background .15s;
  }
  .order-list li.dragging{opacity:.4;}
  .order-list li.drag-over{border-color:var(--orange); background:#fff3e6;}

  /* ===== comparison ===== */
  .compare-row{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:18px;
    font-size:2rem;
    font-weight:900;
    color:var(--navy);
    direction:ltr;
    margin:16px 0;
    flex-wrap:wrap;
  }
  .compare-row .num{background:#fffef9; border:2px solid var(--line); border-radius:12px; padding:10px 22px;}
  .cmp-btn{
    width:56px;height:56px;
    border-radius:50%;
    border:2px solid var(--line);
    background:#fffef9;
    font-size:1.6rem;
    font-weight:900;
    color:var(--navy);
    cursor:pointer;
  }
  .cmp-btn:hover{border-color:var(--orange);}
  .cmp-btn.selected{background:var(--orange); color:#fff; border-color:var(--orange);}

  /* ===== decomposition ===== */
  .decomp-line{
    font-size:1.15rem;
    font-weight:700;
    direction:ltr;
    text-align:center;
    color:var(--navy);
    background:#fffef9;
    border:2px dashed var(--line);
    border-radius:12px;
    padding:16px;
    margin:14px 0;
    line-height:2;
  }
  .decomp-line input{
    width:80px;
    text-align:center;
    margin:0 4px;
  }

  /* ===== difficulty tabs (applications) ===== */
  .diff-tabs{
    display:flex;
    gap:8px;
    margin-bottom:20px;
    flex-wrap:wrap;
  }
  .diff-tab{
    font-family:inherit;
    font-weight:700;
    padding:9px 18px;
    border-radius:100px;
    border:2px solid var(--line);
    background:#fffef9;
    cursor:pointer;
    color:var(--navy);
  }
  .diff-tab.active{color:#fff; border-color:transparent;}
  .diff-tab[data-level="easy"].active{background:var(--mint);}
  .diff-tab[data-level="medium"].active{background:var(--orange);}
  .diff-tab[data-level="hard"].active{background:var(--coral);}
  .diff-panel{display:none;}
  .diff-panel.active{display:block; animation:fadeIn .3s ease;}

  .progress-pill{
    display:inline-block;
    background:var(--navy);
    color:#fff;
    font-size:.8rem;
    font-weight:700;
    padding:4px 12px;
    border-radius:100px;
    margin-bottom:14px;
  }

  .score-box{
    display:flex;
    align-items:center;
    gap:10px;
    background:#f1ecdd;
    border-radius:12px;
    padding:10px 16px;
    font-weight:700;
    color:var(--navy);
    margin-bottom:18px;
    width:fit-content;
  }

  .hint-box{
    background:#fff3e6;
    border:1px solid #f5d9b8;
    border-radius:10px;
    padding:10px 14px;
    font-size:.9rem;
    color:#8a5a1f;
    margin-top:10px;
    display:none;
  }
  .hint-box.show{display:block;}

  footer{
    text-align:center;
    padding:24px;
    color:#8a8175;
    font-size:.85rem;
  }

  @media (max-width:600px){
    header h1{font-size:1.6rem;}
    .stage-title h2{font-size:1.15rem;}
    .compare-row{font-size:1.4rem;}
    table.pv td.cell{font-size:1.15rem; padding:10px 3px;}
    table.pv td.cell input{font-size:1.15rem;}
    .big-number-display{font-size:1.8rem;}
  }
</style>
</head>
<body>

<header>
 <h1>تعلم الرياضيات مع الأستاذ هدار عماد</h1>
  <h2>الأعداد الأقل من 999,999</h2>
  <p>درس تفاعلي في القراءة والكتابة والترتيب والمقارنة والتفكيك</p>
  <div class="badge-row">
    <span>جدول الوحدات</span>
    <span>القراءة والكتابة</span>
    <span>الترتيب والحصر</span>
    <span>المقارنة</span>
    <span>التفكيك</span>
    <span>تطبيقات</span>
  </div>
</header>

<nav>
  <div class="stage-scroller" id="stageNav">
    <button class="stage-btn active" data-stage="s1">1. جدول الوحدات</button>
    <button class="stage-btn" data-stage="s2">2. الكتابة بالحروف</button>
    <button class="stage-btn" data-stage="s3">3. الكتابة بالأرقام</button>
    <button class="stage-btn" data-stage="s4">4. الترتيب</button>
    <button class="stage-btn" data-stage="s5">5. الحصر</button>
    <button class="stage-btn" data-stage="s6">6. المقارنة</button>
    <button class="stage-btn" data-stage="s7">7. التفكيك</button>
    <button class="stage-btn" data-stage="s8">8. تطبيقات</button>
  </div>
</nav>

<main>

  <!-- ============ STAGE 1: جدول الوحدات ============ -->
  <section class="stage active" id="s1">
    <div class="card">
      <div class="stage-title"><span class="icon">🔢</span><h2>الكتابة في جدول الوحدات</h2></div>
      <p class="stage-sub">كل عدد أقل من 999,999 يتكوّن من فئتين: فئة الآلاف وفئة الوحدات. وكل فئة تحتوي على ثلاث مراتب: المئات، والعشرات، والآحاد. اكتب عددًا في الصندوق، ثم شاهد كيف يتوزّع في الجدول.</p>

      <div class="controls">
        <input type="number" id="pvInput" placeholder="اكتب عددًا مثل 47582" min="0" max="999999">
        <button class="action orange" onclick="fillPlaceValueTable()">وزّع العدد في الجدول</button>
        <button class="ghost" onclick="randomPV()">عدد عشوائي</button>
      </div>

      <div class="pv-wrap">
        <table class="pv" id="pvTable">
          <tr>
            <th colspan="3" class="class-head thousands">فئة الآلاف</th>
            <th colspan="3" class="class-head units">فئة الوحدات</th>
          </tr>
          <tr>
            <th>مئات الألوف</th><th>عشرات الألوف</th><th>آحاد الألوف</th>
            <th>المئات</th><th>العشرات</th><th>الآحاد</th>
          </tr>
          <tr>
            <td class="cell" id="pv-cmi">0</td>
            <td class="cell" id="pv-dmi">0</td>
            <td class="cell" id="pv-umi">0</td>
            <td class="cell" id="pv-c">0</td>
            <td class="cell" id="pv-d">0</td>
            <td class="cell" id="pv-u">0</td>
          </tr>
        </table>
      </div>
      <p id="pvExplain" class="stage-sub" style="margin-top:10px;"></p>
    </div>

    <div class="card">
      <div class="stage-title"><span class="icon">✏️</span><h2>تدرّب: أكمل الجدول</h2></div>
      <p class="stage-sub">العدد المطلوب: <strong id="pvTargetDisplay" style="color:var(--orange); font-size:1.2rem;"></strong> — اكتب كل رقم في خانته الصحيحة ثم تحقّق من إجابتك.</p>
      <div class="pv-wrap">
        <table class="pv">
          <tr>
            <th colspan="3" class="class-head thousands">فئة الآلاف</th>
            <th colspan="3" class="class-head units">فئة الوحدات</th>
          </tr>
          <tr>
            <th>مئات الألوف</th><th>عشرات الألوف</th><th>آحاد الألوف</th>
            <th>المئات</th><th>العشرات</th><th>الآحاد</th>
          </tr>
          <tr>
            <td class="cell"><input type="text" maxlength="1" id="q-cmi"></td>
            <td class="cell"><input type="text" maxlength="1" id="q-dmi"></td>
            <td class="cell"><input type="text" maxlength="1" id="q-umi"></td>
            <td class="cell"><input type="text" maxlength="1" id="q-c"></td>
            <td class="cell"><input type="text" maxlength="1" id="q-d"></td>
            <td class="cell"><input type="text" maxlength="1" id="q-u"></td>
          </tr>
        </table>
      </div>
      <div class="controls" style="margin-top:16px;">
        <button class="action mint" onclick="checkPvQuiz()">تحقّق</button>
        <button class="ghost" onclick="newPvQuiz()">عدد جديد</button>
      </div>
      <div class="feedback" id="pvQuizFeedback"></div>
    </div>
  </section>

  <!-- ============ STAGE 2: الكتابة بالحروف ============ -->
  <section class="stage" id="s2">
    <div class="card">
      <div class="stage-title"><span class="icon">🔤</span><h2>الكتابة بالحروف</h2></div>
      <p class="stage-sub">نقرأ العدد فئةً فئة: أولًا فئة الآلاف، ثم فئة الوحدات، ونصل بينهما بكلمة "و" عند الحاجة.</p>
      <div class="controls">
        <input type="number" id="w2n-input" placeholder="اكتب عددًا مثل 3208" min="0" max="999999">
        <button class="action orange" onclick="showWordsFromNumber()">اكتب بالحروف</button>
        <button class="ghost" onclick="randomWordsNumber()">عدد عشوائي</button>
      </div>
      <div class="big-number-display" id="w2n-result" style="direction:rtl; font-size:1.4rem;"></div>
    </div>

    <div class="card">
      <div class="stage-title"><span class="icon">🎯</span><h2>تدرّب: اختر الكتابة الصحيحة بالحروف</h2></div>
      <div class="score-box">النقاط: <span id="s2score">0</span> / <span id="s2total">0</span></div>
      <div id="s2exercises"></div>
      <div class="controls" style="margin-top:10px;">
        <button class="ghost" onclick="buildStage2Exercises()">تمارين جديدة</button>
      </div>
    </div>
  </section>

  <!-- ============ STAGE 3: الكتابة بالأرقام ============ -->
  <section class="stage" id="s3">
    <div class="card">
      <div class="stage-title"><span class="icon">🔢</span><h2>الكتابة بالأرقام</h2></div>
      <p class="stage-sub">هنا نفعل العكس: نقرأ العدد مكتوبًا بالحروف، ونحوّله إلى رقم.</p>
      <p id="s3phrase" class="decomp-line" style="direction:rtl;"></p>
      <div class="controls">
        <input type="number" id="s3answer" placeholder="اكتب العدد بالأرقام">
        <button class="action mint" onclick="checkS3()">تحقّق</button>
        <button class="ghost" onclick="newS3()">سؤال جديد</button>
      </div>
      <div class="feedback" id="s3feedback"></div>
    </div>
  </section>

  <!-- ============ STAGE 4: الترتيب ============ -->
  <section class="stage" id="s4">
    <div class="card">
      <div class="stage-title"><span class="icon">📶</span><h2>الترتيب</h2></div>
      <p class="stage-sub">اسحب الأعداد لترتيبها تصاعديًا (من الأصغر إلى الأكبر). عند الانتهاء اضغط "تحقّق".</p>
      <ul class="order-list" id="orderList"></ul>
      <div class="controls" style="margin-top:16px;">
        <button class="action mint" onclick="checkOrder()">تحقّق من الترتيب</button>
        <button class="ghost" onclick="buildOrderExercise()">مجموعة أعداد جديدة</button>
      </div>
      <div class="feedback" id="orderFeedback"></div>
    </div>
  </section>

  <!-- ============ STAGE 5: الحصر ============ -->
  <section class="stage" id="s5">
    <div class="card">
      <div class="stage-title"><span class="icon">🎯</span><h2>الحصر</h2></div>
      <p class="stage-sub">حصر عدد يعني إيجاد العدد الطبيعي الذي يسبقه مباشرة، والعدد الطبيعي الذي يليه مباشرة.</p>
      <div class="decomp-line" id="hasrLine" style="font-size:1.6rem;"></div>
      <div class="controls">
        <input type="number" id="hasrBefore" placeholder="العدد السابق" style="width:140px;">
        <span style="align-self:center; font-weight:900; color:var(--navy);">&lt; ؟ &lt;</span>
        <input type="number" id="hasrAfter" placeholder="العدد اللاحق" style="width:140px;">
        <button class="action mint" onclick="checkHasr()">تحقّق</button>
        <button class="ghost" onclick="newHasr()">عدد جديد</button>
      </div>
      <div class="feedback" id="hasrFeedback"></div>
    </div>
  </section>

  <!-- ============ STAGE 6: المقارنة ============ -->
  <section class="stage" id="s6">
    <div class="card">
      <div class="stage-title"><span class="icon">⚖️</span><h2>المقارنة</h2></div>
      <p class="stage-sub">قارن بين العددين باستخدام إحدى الإشارات: أكبر من &gt;، أصغر من &lt;، يساوي =.</p>
      <div class="compare-row" id="cmpRow"></div>
