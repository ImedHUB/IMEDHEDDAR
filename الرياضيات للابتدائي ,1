        if(b.dataset.correct === 'true') b.classList.add('correct');
        else if(b===btn) b.classList.add('wrong');
      });
      document.getElementById('s2score').textContent = s2State.score;
      document.getElementById('s2total').textContent = s2State.total;
    });
