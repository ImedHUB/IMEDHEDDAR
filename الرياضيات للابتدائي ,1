const appliedState = {easy:{score:0,total:0}, medium:{score:0,total:0}, hard:{score:0,total:0}};

function buildApplied(level){
  appliedState[level] = {score:0,total:0};
  document.getElementById(level+'Score').textContent = 0;
  document.getElementById(level+'Total').textContent = 0;
  const container = document.getElementById(level+'Exercises');
  container.innerHTML = '';

  const generators = {
    easy: [genEasyReadNumber, genEasyPlaceDigit, genEasyCompareSimple],
    medium: [genMediumOrderWord, genMediumHasr, genMediumDecompCheck],
    hard: [genHardWordToNumberOp, genHardCompareExpr, genHardMissingDigit]
  };
  const gens = generators[level];
  const count = 4;
  for(let i=0;i<count;i++){
    const gen = gens[i % gens.length];
    const ex = gen();
    renderApplied(container, ex, level);
  }
}

function renderApplied(container, ex, level){
  const div = document.createElement('div');
  div.className = 'exercise';
  if(ex.type === 'mcq'){
    div.innerHTML = `<div class="ex-q">${ex.question}</div>
      <div class="options">${ex.options.map(o=>`<button class="opt-btn" data-correct="${o===ex.answer}">${o}</button>`).join('')}</div>`;
    container.appendChild(div);
    div.querySelectorAll('.opt-btn').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        if(div.dataset.answered) return;
        div.dataset.answered = "1";
        appliedState[level].total++;
        if(btn.dataset.correct==='true') appliedState[level].score++;
        div.querySelectorAll('.opt-btn').forEach(b=>{
          b.disabled=true;
          if(b.dataset.correct==='true') b.classList.add('correct');
          else if(b===btn) b.classList.add('wrong');
        });
        document.getElementById(level+'Score').textContent = appliedState[level].score;
        document.getElementById(level+'Total').textContent = appliedState[level].total;
      });
    });
  } else if(ex.type === 'input'){
    const inputId = 'app-'+Math.random().toString(36).slice(2,9);
    div.innerHTML = `<div class="ex-q">${ex.question}</div>
      <div class="controls">
        <input type="text" id="${inputId}" placeholder="إجابتك">
        <button class="action mint" data-input="${inputId}">تحقّق</button>
      </div>
      <div class="feedback" data-fb></div>`;
    container.appendChild(div);
    const btn = div.querySelector('button');
    btn.addEventListener('click', ()=>{
      if(div.dataset.answered) return;
      const userVal = document.getElementById(inputId).value.trim();
      const fb = div.querySelector('[data-fb]');
      fb.classList.add('show');
      div.dataset.answered = "1";
      appliedState[level].total++;
      let ok;
      if(typeof ex.answer === 'number'){
        ok = parseInt(userVal) === ex.answer;
      } else {
        ok = userVal.trim() === String(ex.answer).trim();
      }
      if(ok){
        appliedState[level].score++;
        fb.className='feedback show ok';
        fb.textContent = 'إجابة صحيحة! ✅';
      } else {
        fb.className='feedback show bad';
        fb.textContent = `غير صحيحة، الجواب الصحيح: ${typeof ex.answer==='number' ? toDigits(ex.answer) : ex.answer}`;
      }
      document.getElementById(level+'Score').textContent = appliedState[level].score;
      document.getElementById(level+'Total').textContent = appliedState[level].total;
    });
  }
}

/* --- easy generators --- */
function genEasyReadNumber(){
  const n = randInt(10, 9999);
  const correct = numberToArabicWords(n);
  let d1 = numberToArabicWords(randInt(10,9999));
  let d2 = numberToArabicWords(randInt(10,9999));
  const opts = shuffleArr([correct,d1,d2]);
  return {type:'mcq', question:`اقرأ العدد ${toDigits(n)} — اختر كتابته الصحيحة بالحروف:`, options:opts, answer:correct};
}
function genEasyPlaceDigit(){
  const n = randInt(1000, 99999);
  const p = splitPlaceValues(n);
  const places = [['الآحاد',p.u],['العشرات',p.d],['المئات',p.c]];
  const [name, digit] = places[randInt(0,2)];
  return {type:'input', question:`في العدد ${toDigits(n)}، ما رقم خانة ${name}؟`, answer: parseInt(digit)};
}
function genEasyCompareSimple(){
  const a = randInt(1,999999), b = randInt(1,999999);
  const correct = a>b?'أكبر من':(a<b?'أصغر من':'يساوي');
  const opts = shuffleArr(['أكبر من','أصغر من','يساوي']);
  return {type:'mcq', question:`العدد ${toDigits(a)} .... العدد ${toDigits(b)}`, options:opts, answer:correct};
}

/* --- medium generators --- */
function genMediumOrderWord(){
  const nums = [randInt(1,999999), randInt(1,999999), randInt(1,999999)];
  const maxN = Math.max(...nums);
  const opts = shuffleArr(nums.map(n=>toDigits(n)));
  return {type:'mcq', question:`أي الأعداد التالية هو الأكبر؟`, options:opts, answer: toDigits(maxN)};
}
function genMediumHasr(){
  const n = randInt(2,999998);
  return {type:'input', question:`ما العدد الذي يسبق ${toDigits(n)} مباشرة؟`, answer:n-1};
}
function genMediumDecompCheck(){
  const n = randInt(1000,99999);
  const parts = decompositionParts(n);
  const missingIdx = randInt(0, parts.length-1);
  const p = parts[missingIdx];
  const shown = parts.map((pp,i)=> i===missingIdx? '(? × '+toDigits(pp.value)+')' : `(${toDigits(pp.digit)} × ${toDigits(pp.value)})`).join(' + ');
  return {type:'input', question:`أكمل: ${toDigits(n)} = ${shown} — ما القيمة الناقصة (الرقم فقط)؟`, answer: p.digit};
}

/* --- hard generators --- */
function genHardWordToNumberOp(){
  const a = randInt(1000,99999);
  const b = randInt(1,500);
  return {type:'input', question:`اكتب بالأرقام ناتج: "${numberToArabicWords(a)}" زائد ${toDigits(b)}`, answer: a+b};
}
function genHardCompareExpr(){
  const a = randInt(100,999999);
  const b1 = randInt(1,500), b2 = randInt(1,500);
  const left = a;
  const right = a - b1 + b2;
  const correct = left>right?'أكبر من':(left<right?'أصغر من':'يساوي');
  const question = `قارن: ${toDigits(left)} .... (${toDigits(a)} - ${toDigits(b1)} + ${toDigits(b2)})`;
  const opts = shuffleArr(['أكبر من','أصغر من','يساوي']);
  return {type:'mcq', question, options:opts, answer:correct};
}
function genHardMissingDigit(){
  const n = randInt(10000,999999);
  const p = splitPlaceValues(n);
  const digits = ['cmi','dmi','umi','c','d','u'];
  const names = {cmi:'مئات الألوف', dmi:'عشرات الألوف', umi:'آحاد الألوف', c:'المئات', d:'العشرات', u:'الآحاد'};
  const key = digits[randInt(0,5)];
  return {type:'input', question:`العدد ${toDigits(n)} — ما قيمة رقم خانة ${names[key]} مضروبًا في مرتبته؟ (مثال: إذا كان الرقم في خانة المئات هو 4، فالإجابة 400)`,
    answer: (()=>{
      const placeValues = {cmi:100000,dmi:10000,umi:1000,c:100,d:10,u:1};
      return parseInt(p[key]) * placeValues[key];
    })()
  };
}

function shuffleArr(arr){
  const a = [...arr];
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

