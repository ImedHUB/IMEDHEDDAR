/* ============ STAGE 7: تفكيك ============ */
function decompositionParts(n){
  const p = splitPlaceValues(n);
  const places = [
    {digit: parseInt(p.cmi), value:100000},
    {digit: parseInt(p.dmi), value:10000},
    {digit: parseInt(p.umi), value:1000},
    {digit: parseInt(p.c), value:100},
    {digit: parseInt(p.d), value:10},
    {digit: parseInt(p.u), value:1},
  ];
  return places.filter(pl=>pl.digit>0);
}
function showDecomposition(){
  const val = parseInt(document.getElementById('decompInput').value);
  const out = document.getElementById('decompResult');
  if(isNaN(val) || val<0 || val>999999){
    out.textContent = 'الرجاء إدخال عدد صحيح بين 0 و 999,999.';
    return;
  }
  const parts = decompositionParts(val);
  const str = parts.map(p=>`(${toDigits(p.digit)} × ${toDigits(p.value)})`).join(' + ');
  out.textContent = `${toDigits(val)} = ${str || '0'}`;
}
function randomDecomp(){
  document.getElementById('decompInput').value = randInt(100,999999);
  showDecomposition();
}
showDecomposition();

