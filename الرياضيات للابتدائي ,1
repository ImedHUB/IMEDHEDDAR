let s2State = {score:0, total:0};
function buildStage2Exercises(){
  const container = document.getElementById('s2exercises');
  container.innerHTML = '';
  s2State = {score:0, total:0};
  document.getElementById('s2score').textContent = 0;
  document.getElementById('s2total').textContent = 0;

  for(let i=0;i<4;i++){
    const correctNum = randInt(100, 999999);
    const correctWords = numberToArabicWords(correctNum);
    let distractor1 = randInt(100,999999);
    while(distractor1 === correctNum) distractor1 = randInt(100,999999);
    let distractor2 = randInt(100,999999);
    while(distractor2 === correctNum || distractor2 === distractor1) distractor2 = randInt(100,999999);

    const options = [correctWords, numberToArabicWords(distractor1), numberToArabicWords(distractor2)];
    for(let j=options.length-1;j>0;j--){
      const k = Math.floor(Math.random()*(j+1));
      [options[j],options[k]]=[options[k],options[j]];
    }

    const div = document.createElement('div');
    div.className = 'exercise';
    div.innerHTML = `<div class="ex-q">كيف تُكتب ${toDigits(correctNum)} بالحروف؟</div>
